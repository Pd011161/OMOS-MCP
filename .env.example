# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง:  cp .env.example .env
# (.env ถูก gitignore แล้ว — ห้าม commit key ขึ้น repo)

# folder id ของ root OMOS — เอาจาก URL: https://drive.google.com/drive/folders/<อันนี้>
OMOS_ROOT_FOLDER_ID=

# path ไปยังไฟล์ service account key หรือจะ paste เนื้อ JSON ทั้งก้อนก็ได้
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# อายุ cache ของ index (วินาที) — ไม่ต้องแก้ก็ได้
# OMOS_INDEX_TTL=300

# --- ใช้เฉพาะตอนรันแบบ HTTP (uv run omos-mcp-http) ---
# OMOS_AUTH_TOKEN=change-me-to-a-long-random-string
# PORT=8000
